{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omphalos.local/schemas/case-1.0.json",
  "title": "omphalOS Case (v1.0)",
  "type": "object",
  "required": [
    "case_id",
    "question",
    "scope",
    "investigations",
    "packs",
    "profiles"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "time_window_days",
        "domains"
      ],
      "properties": {
        "time_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "investigations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packs": {
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": true
}