{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omphalos.local/schemas/run-1.0.json",
  "title": "omphalOS Run Manifest (v1.0)",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "created_utc",
    "checksums"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "created_utc": {
      "type": "string"
    },
    "checksums": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}