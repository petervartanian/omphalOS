{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omphalos.local/schemas/packet-1.0.json",
  "title": "omphalOS Packet (v1.0)",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "run_id",
    "created_utc",
    "question",
    "scope",
    "memo",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "created_utc": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "memo": {
      "type": "string",
      "minLength": 20
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "kind",
          "text",
          "evidence",
          "unknowns",
          "alternatives",
          "falsifiers"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "artifact",
                "sha256",
                "sql",
                "sql_sha256"
              ],
              "properties": {
                "artifact": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "sql": {
                  "type": "string"
                },
                "sql_sha256": {
                  "type": "string"
                }
              }
            }
          },
          "unknowns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "falsifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}